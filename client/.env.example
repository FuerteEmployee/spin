# Firebase web app config (Phone OTP + Analytics). These are the TEST project keys;
# replace them with the real project's values from Firebase console → Project settings → Your apps.
# Also set FIREBASE_PROJECT_ID in server/.env to the same project id.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Local testing only: skips reCAPTCHA so Firebase "phone numbers for testing" work on localhost.
# Real numbers do NOT work while this is true. Must be false for the live site.
VITE_FIREBASE_PHONE_TEST_MODE=false
