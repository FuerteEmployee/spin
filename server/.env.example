PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/spin_win
# Optional: DNS servers for the mongodb+srv lookup, if Node can't resolve it (seen on some Windows setups)
DNS_SERVERS=
JWT_SECRET=change-this-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
# Only when the website is on another domain than this server: this server's own URL (for image links)
PUBLIC_URL=

# Admin panel login at /admin (brand, rewards, T&C, backgrounds, participants)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# OTP: "firebase" = real SMS via Firebase Phone Auth (needs the client/.env Firebase keys),
# "screen" = OTP shown on screen, no SMS (testing only)
OTP_MODE=screen
FIREBASE_PROJECT_ID=

# Screen mode only: show the OTP on screen instead of sending an SMS (set false once an SMS provider is wired in)
SHOW_OTP_ON_SCREEN=true
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=30
